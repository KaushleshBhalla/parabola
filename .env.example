# Copy this file to .env.local and fill in real values. .env.local is
# gitignored — never commit it, and never commit real values anywhere else.

# ── Database (Supabase Postgres) ────────────────────────────────────────────
# Supabase Project Settings -> Database -> Connection string -> "Transaction"
# pooler (port 6543). Used by the running app.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres"

# Same project, "Direct connection" (port 5432). Used only by drizzle-kit and
# the scripts/ tooling — the transaction pooler above doesn't support the
# session features those need for introspection.
DIRECT_URL="postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres"

# ── Supabase (API) ───────────────────────────────────────────────────────────
# Supabase Project Settings -> API
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="service-role-secret-key"
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="anon-public-key"

# ── Clerk (auth) ─────────────────────────────────────────────────────────────
# Clerk Dashboard -> Configure -> Paths
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Clerk Dashboard -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxx"
CLERK_SECRET_KEY="sk_test_xxxx"

# Clerk Dashboard -> Webhooks -> add endpoint https://<your-domain>/api/webhooks/clerk,
# subscribed to the "user.created" event -> copy the signing secret it gives you.
# Read implicitly by verifyWebhook() in app/api/webhooks/clerk/route.ts.
CLERK_WEBHOOK_SIGNING_SECRET="whsec_xxxx"

# ── Encryption ───────────────────────────────────────────────────────────────
# Any long random string (e.g. `openssl rand -hex 32`). Signs the short-lived
# token used to link a Discord account to a Parabola login (lib/discord/link-token.ts).
ENCRYPTION_KEY=""

# ── Discord bot ──────────────────────────────────────────────────────────────
# Discord Developer Portal (discord.com/developers/applications) -> your app
# -> General Information.
DISCORD_APPLICATION_ID=""
# -> Bot -> Reset Token. Only needed to send messages/register commands as
# the bot; never exposed to the browser.
DISCORD_BOT_TOKEN=""
# -> General Information -> Public Key. Not secret — used to verify that
# incoming interaction requests really came from Discord.
DISCORD_PUBLIC_KEY=""
# -> OAuth2 -> Client Secret. Currently unused by the app (no OAuth code
# grant flow implemented) — kept for when/if that's added.
DISCORD_CLIENT_SECRET=""

# ── Razorpay (optional, not yet wired) ──────────────────────────────────────
# Razorpay Dashboard -> Settings -> API Keys. Nothing in the app currently
# calls lib/payments/razorpay.ts, so these can stay empty.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
